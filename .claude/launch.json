{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5174"
      ],
      "port": 5174
    },
    {
      "name": "prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "4173",
        "--host"
      ],
      "port": 4173
    },
    {
      "name": "protocol-app",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "protocol-app",
        "--port",
        "5175"
      ],
      "port": 5175
    },
    {
      "name": "protocol-app-dist",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const http=require('http'),fs=require('fs'),p=require('path');const root=p.resolve('protocol-app/dist');const T={'.html':'text/html','.js':'text/javascript','.json':'application/json','.css':'text/css','.jpg':'image/jpeg','.png':'image/png','.webmanifest':'application/manifest+json'};const port=Number(process.env.PORT)||8788;http.createServer((q,s)=>{let f=p.join(root,decodeURIComponent(q.url.split('?')[0]));if(!f.startsWith(root))return s.end();if(!fs.existsSync(f)||fs.statSync(f).isDirectory())f=p.join(root,'index.html');s.writeHead(200,{'content-type':T[p.extname(f)]||'application/octet-stream'});fs.createReadStream(f).pipe(s);}).listen(port,()=>console.log('serving protocol-app/dist on '+port));"],
      "autoPort": true,
      "port": 8788
    },
    {
      "name": "protocol-app-static",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--outDir",
        "protocol-app",
        "--port",
        "5176"
      ],
      "port": 5176
    }
  ]
}